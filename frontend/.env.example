# Em Docker Compose, estas variáveis vêm do `.env` na raiz do projeto
# e são injetadas no frontend pelo `docker-compose`.

# API Matriz de Priorização (FastAPI)
# Em Docker Compose, o frontend fala com o backend pelo nome do serviço.
PRIORIZACAO_API_URL=http://backend:8000
# Opcional: só ative em desenvolvimento se quiser fallback mock quando a API estiver indisponível.
PRIORIZACAO_ANALISE_ALLOW_MOCK_FALLBACK=false

# Para rodar o frontend fora do Docker, use:
# PRIORIZACAO_API_URL=http://127.0.0.1:8000
