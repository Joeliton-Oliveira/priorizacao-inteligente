# Portas publicadas no host
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Postgres 18
POSTGRES_DB=Matriz
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend (injetado pelo docker-compose no container do backend)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=Matriz
DB_USER=postgres
DB_PASSWORD=postgres
# true = popula projetos/bugs/features no primeiro start se o banco estiver vazio
SEED_INICIAL_ON_STARTUP=true
GEMINI_API_KEY=

# Frontend (injetado pelo docker-compose no container do frontend)
PRIORIZACAO_API_URL=http://backend:8000
# Deixe como false para usar sempre a API real; true habilita mock apenas em desenvolvimento
PRIORIZACAO_ANALISE_ALLOW_MOCK_FALLBACK=false
NEXT_TELEMETRY_DISABLED=1
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true