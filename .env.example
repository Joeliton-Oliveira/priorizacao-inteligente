# Portas publicadas no host
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Postgres 18
POSTGRES_DB=Matriz
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend (injetado pelo docker-compose no container do backend)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=Matriz
DB_USER=postgres
DB_PASSWORD=postgres
GEMINI_API_KEY=

# Frontend (injetado pelo docker-compose no container do frontend)
PRIORIZACAO_API_URL=http://backend:8000
NEXT_TELEMETRY_DISABLED=1
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
