# Em Docker Compose, estas variáveis vêm do `.env` na raiz do projeto
# e são injetadas no backend pelo `docker-compose`.

# Chave da API Gemini (opcional em desenvolvimento)
GEMINI_API_KEY=

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Matriz
DB_USER=postgres
DB_PASSWORD=postgres
